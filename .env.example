# Team Tomate HQ — configuration
#
# Sans ces variables, l'application démarre en MODE DÉMO : données fictives
# enregistrées dans le navigateur, aucune authentification.
#
# Avec ces variables, elle utilise Supabase (Postgres + Auth + Realtime).
# Projet hébergé : Project Settings → API. En local : `npx supabase status`.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Uniquement pour `npm run seed:local` (jamais exposée au navigateur, jamais en production).
SUPABASE_SECRET_KEY=
